{
  "name": "mortgage-suite-los",
  "version": "54.0.0",
  "description": "Mortgage Suite: Income Calculator and Loan Suite in one self-contained, offline-capable web app.",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "python3 build/build.py",
    "build:dev": "python3 build/build.py --no-minify",
    "test": "node --test test/node/build.test.js",
    "test:browser": "sh test/browser/run.sh dist/mortgage-suite-los.html",
    "verify": "npm run build && npm test && npm run test:browser",
    "split": "python3 tools/split_parts.py"
  },
  "devDependencies": {
    "csso": "^5.0.5",
    "terser": "^5.51.2"
  },
  "engines": { "node": ">=18" }
}
